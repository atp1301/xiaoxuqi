# Copy these variables into your shell only when you want model-assisted analysis.
# Never commit a real key or put it in a command-line argument.
HARNESS_LLM_API_KEY=
# Kapibala/New API OpenAI-compatible endpoint.
# The wallet page creates the key; do not paste it into this file.
HARNESS_LLM_BASE_URL=https://kapibala.asia/v1
HARNESS_LLM_MODEL=在钱包中启用的模型名
HARNESS_LLM_PROVIDER=kapibala-new-api
HARNESS_LLM_TIMEOUT=60
