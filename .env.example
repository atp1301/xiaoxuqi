# Copy these variables into your shell only when you want model-assisted analysis.
# Never commit a real key or put it in a command-line argument.
HARNESS_LLM_API_KEY=
# Kapibala/New API OpenAI-compatible endpoint.
# The wallet page creates the key; do not paste it into this file.
HARNESS_LLM_BASE_URL=https://kapibala.asia/v1
HARNESS_LLM_MODEL=在钱包中启用的模型名
HARNESS_LLM_PROVIDER=kapibala-new-api
# A reasoning model measured 61.5 s per call, so 60 was too low to succeed.
HARNESS_LLM_TIMEOUT=180
# The gateway 504s at roughly 120 s on a realistic prompt, and a reasoning
# model needs 37 s just to answer "ok", so it can never finish a real call
# here. Pick a fast model on this endpoint; deepseek-v4-flash-0731 measured
# 6.8 s per graded call and gemini-3.8-flash 18.1 s.
